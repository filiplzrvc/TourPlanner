<Window x:Class="TourPlanner.UI.Views.EditTourWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Tour" Height="650" Width="450"
        Background="#FAFAFA" WindowStartupLocation="CenterScreen">
    <Border Background="White" CornerRadius="10" Padding="20" Margin="10" BorderBrush="#DDDDDD" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titel -->
            <TextBlock Text="Edit Tour"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#333333"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- Formular -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10,0" VerticalAlignment="Top">
                    <Label Content="Name:"/>
                    <TextBox Text="{Binding EditedTour.Name}" Margin="0,0,0,10" Padding="6"/>

                    <Label Content="Description:"/>
                    <TextBox Text="{Binding EditedTour.Description}" Margin="0,0,0,10" Padding="6"/>

                    <Label Content="From:"/>
                    <TextBox Text="{Binding EditedTour.From}" Margin="0,0,0,10" Padding="6"/>

                    <Label Content="To:"/>
                    <TextBox Text="{Binding EditedTour.To}" Margin="0,0,0,10" Padding="6"/>

                    <Label Content="Transport Type:"/>
                    <ComboBox ItemsSource="{Binding TransportTypes}"
                              SelectedItem="{Binding EditedTour.TransportType}"
                              Margin="0,0,0,10"
                              Padding="6"/>

                    <!-- Image Sektion -->
                    <Label Content="Image:"/>
                    <Border BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,5" Background="#F8F8F8" MinHeight="120">
                        <Image Source="{Binding ImagePath}" 
                               Height="100" 
                               Margin="5"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Style.Triggers>
                                        <Trigger Property="Source" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </Border>

                    <Button Content="Choose New Image"
                            Command="{Binding SelectImageCommand}"
                            Margin="0,0,0,10"
                            Padding="6"
                            Background="#2196F3"
                            Foreground="White"
                            BorderThickness="0"/>

                    <!-- Info Text -->
                    <TextBlock Text="Leave unchanged to keep current image"
                               FontStyle="Italic"
                               Foreground="Gray"
                               FontSize="11"
                               Margin="0,0,0,10"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Button -->
            <Button Content="Update Tour"
                    Grid.Row="2"
                    Command="{Binding ConfirmEditTourCommand}"
                    Background="#1976D2"
                    Foreground="White"
                    FontWeight="Bold"
                    Padding="10"
                    Margin="0,20,0,0"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"/>
        </Grid>
    </Border>
</Window>