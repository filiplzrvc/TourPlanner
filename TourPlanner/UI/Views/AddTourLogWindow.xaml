<Window x:Class="TourPlanner.UI.Views.AddTourLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Tour Log" Height="597" Width="450"
        Background="#FAFAFA" WindowStartupLocation="CenterScreen">

    <Border Background="White" CornerRadius="10" Padding="20" Margin="10" BorderBrush="#DDDDDD" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titel -->
            <TextBlock Text="Add Tour Log"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#333333"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- Formular -->
            <StackPanel Grid.Row="1" Margin="10,0" VerticalAlignment="Top">
                <Label Content="Date:"/>
                <DatePicker SelectedDate="{Binding LogDate}" Margin="0,0,0,10" Padding="6"/>

                <Label Content="Comment:"/>
                <TextBox Text="{Binding LogComment}" Margin="0,0,0,10" Padding="6"/>

                <Label Content="Difficulty (1-5):"/>
                <TextBox Text="{Binding LogDifficulty}" Margin="0,0,0,10" Padding="6"/>

                <Label Content="Total Distance (km):"/>
                <TextBox Text="{Binding LogTotalDistance}" Margin="0,0,0,10" Padding="6"/>

                <Label Content="Total Time (h):"/>
                <TextBox Text="{Binding LogTotalTime}" Margin="0,0,0,10" Padding="6"/>

                <Label Content="Rating (1-5):"/>
                <TextBox Text="{Binding LogRating}" Margin="0,0,0,10" Padding="6"/>
            </StackPanel>

            <!-- Button -->
            <Button Content="Add Log"
                    Grid.Row="2"
                    Command="{Binding ConfirmAddLogCommand}"
                    Background="#1976D2"
                    Foreground="White"
                    FontWeight="Bold"
                    Padding="10"
                    Margin="0,20,0,0"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"/>
        </Grid>
    </Border>
</Window>
