<Window x:Class="TourPlanner.UI.Views.AddTourLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TourPlanner.UI.Views"
        mc:Ignorable="d"
        Title="AddTourLogWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Date:" Grid.Row="0" Grid.Column="0" Margin="5"/>
        <DatePicker SelectedDate="{Binding LogDate, Mode=TwoWay}" Grid.Row="0" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Comment:" Grid.Row="1" Grid.Column="0" Margin="5"/>
        <TextBox Text="{Binding LogComment, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Difficulty (1-5):" Grid.Row="2" Grid.Column="0" Margin="5"/>
        <TextBox Text="{Binding LogDifficulty, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Total Distance (km):" Grid.Row="3" Grid.Column="0" Margin="5"/>
        <TextBox Text="{Binding LogTotalDistance, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Total Time (h):" Grid.Row="4" Grid.Column="0" Margin="5"/>
        <TextBox Text="{Binding LogTotalTime, UpdateSourceTrigger=PropertyChanged}" Grid.Row="4" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Rating (1-5):" Grid.Row="5" Grid.Column="0" Margin="5"/>
        <TextBox Text="{Binding LogRating, UpdateSourceTrigger=PropertyChanged}" Grid.Row="5" Grid.Column="1" Margin="5"/>

        <Button Content="Add Log" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="5" Padding="5"
                Command="{Binding ConfirmAddLogCommand}"/>
    </Grid>
</Window>
