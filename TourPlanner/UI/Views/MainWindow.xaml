<Window x:Class="TourPlanner.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TourPlanner"
        mc:Ignorable="d"
        Title="Tours" Height="600" Width="700" Background="#F5F5F5">

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#E3E3E3">
            <MenuItem Header="File"/>
            <MenuItem Header="Edit"/>
            <MenuItem Header="Options"/>
            <MenuItem Header="Help"/>
        </Menu>

        <DockPanel DockPanel.Dock="Top" Background="#FFFFFF" >
            <Grid VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="Search..." Grid.Column="0" Margin="5" Height="25"/>
                <Button Content="Search" Grid.Column="1" Margin="5" Padding="5,2" Background="#007ACC" Foreground="White"/>
            </Grid>
        </DockPanel>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Tours List -->
            <StackPanel Grid.Column="0" Background="#E0F7FA" >
                <Grid>
                    <TextBlock Text="Tours" FontWeight="Bold" FontSize="14"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="+" Command="{Binding OpenAddTourWindowCommand}" Padding="3" Background="#4CAF50" Foreground="White"/>
                        <Button Content="-" Command="{Binding DeleteTourCommand}" Padding="3" Background="#F44336" Foreground="White"/>
                        <Button Content="..." Command="{Binding OpenEditTourWindowCommand}" Padding="3" Background="#FFC107" Foreground="Black"/>
                    </StackPanel>
                </Grid>
                <ListBox ItemsSource="{Binding Tours}" Margin="10" SelectedItem="{Binding SelectedTour, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Margin="3"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- Right Panel: Tour Details -->
            <StackPanel Grid.Column="1" Margin="10">
                <StackPanel Orientation="Horizontal">
                    <Button Content="General" Margin="3,3,3,0" Background="#1976D2" Foreground="White"/>
                    <Button Content="Route" Margin="3,3,3,0" Background="#1976D2" Foreground="White"/>
                    <Button Content="Misc" Margin="3,3,3,0" Background="#1976D2" Foreground="White"/>
                </StackPanel>
                <Border Background="#E3E3E3" Height="5" Margin="5,10"/>

                <StackPanel DataContext="{Binding SelectedTour}">
                    <Image Source="{Binding Image}" Margin="3" Height="150" Width="300"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Date:" Grid.Row="0" Grid.Column="0" Margin="6"/>
                        <TextBlock Text="{Binding Date}" Grid.Row="0" Grid.Column="1" Margin="6"/>
                        <TextBlock Text="Name:" Grid.Row="1" Grid.Column="0" Margin="6"/>
                        <TextBlock Text="{Binding Name}" Grid.Row="1" Grid.Column="1" Margin="6"/>
                        <TextBlock Text="Description:" Grid.Row="2" Grid.Column="0" Margin="6"/>
                        <TextBlock Text="{Binding Description}" Grid.Row="2" Grid.Column="1" Margin="6"/>
                        <TextBlock Text="From:" Grid.Row="3" Grid.Column="0" Margin="6"/>
                        <TextBlock Text="{Binding From}" Grid.Row="3" Grid.Column="1" Margin="6"/>
                        <TextBlock Text="To:" Grid.Row="4" Grid.Column="0" Margin="6"/>
                        <TextBlock Text="{Binding To}" Grid.Row="4" Grid.Column="1" Margin="6"/>
                        <TextBlock Text="TransportType:" Grid.Row="5" Grid.Column="0" Margin="6"/>
                        <TextBlock Text="{Binding TransportType}" Grid.Row="5" Grid.Column="1" Margin="6"/>
                    </Grid>
                </StackPanel>

                <TextBlock Text="Tour Logs" FontWeight="Bold" FontSize="14" Margin="10,15,10,5"/>
                <ListBox ItemsSource="{Binding SelectedTour.TourLogs}" SelectedItem="{Binding SelectedTourLog, Mode=TwoWay}" Margin="10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" Margin="5">
                                <TextBlock Text="{Binding Date}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Comment}" FontStyle="Italic"/>
                                <TextBlock Text="{Binding Difficulty, StringFormat='Difficulty: {0}'}"/>
                                <TextBlock Text="{Binding TotalDistance, StringFormat='Distance: {0} km'}"/>
                                <TextBlock Text="{Binding TotalTime, StringFormat='Time: {0} h'}"/>
                                <TextBlock Text="{Binding Rating, StringFormat='Rating: {0}/5'}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,10,0,0">
                    <Button Content="Add Log" Command="{Binding OpenAddTourLogWindowCommand}" Margin="5" Background="#4CAF50" Foreground="White"/>
                    <Button Content="Edit Log" Command="{Binding OpenEditTourLogWindowCommand}" Margin="5" IsEnabled="{Binding SelectedTourLog}" Background="#FFC107" Foreground="Black"/>
                    <Button Content="Delete Log" Command="{Binding DeleteTourLogCommand}" Margin="5" IsEnabled="{Binding SelectedTourLog}" Background="#F44336" Foreground="{Binding DeleteTextColor}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
