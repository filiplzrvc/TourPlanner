<UserControl x:Class="TourPlanner.UI.Views.Components.TourListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="#FAFAFA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopfzeile -->
        <DockPanel Margin="20" Grid.Row="0">
            <TextBlock Text="Tours"
                       FontSize="20"
                       FontWeight="Bold"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Foreground="#333" />

            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                <Button Content="Add"
                        Command="{Binding OpenAddTourWindowCommand}"
                        Background="#4CAF50"
                        Foreground="White"
                        Padding="10,5"
                        Margin="5,0"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"/>

                <Button Content="Delete"
                        Command="{Binding DeleteTourCommand}"
                        Background="#F44336"
                        Foreground="White"
                        Padding="10,5"
                        Margin="5,0"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"/>

                <Button Content="Edit"
                        Command="{Binding OpenEditTourWindowCommand}"
                        Background="#FF9800"
                        Foreground="White"
                        Padding="10,5"
                        Margin="5,0"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
        </DockPanel>


        <!-- Tourliste -->
        <ScrollViewer Grid.Row="1" Margin="20,0" VerticalScrollBarVisibility="Auto">
            <ListBox ItemsSource="{Binding FilteredTours}"
                     SelectedItem="{Binding SelectedTour, Mode=TwoWay}"
                     Background="White"
                     BorderBrush="#DDD"
                     BorderThickness="1"
                     Padding="6"
                     MinHeight="100">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#F0F0F0"
                                Padding="10"
                                Margin="4"
                                CornerRadius="6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.25"/>
                            </Border.Effect>
                            <TextBlock Text="{Binding Name}"
                                       FontSize="14"
                                       Foreground="#333"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Focusable="False"/>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

        <!-- Kein-Inhalt-Hinweis -->
        <TextBlock Text="No tours available"
                   FontStyle="Italic"
                   Foreground="Gray"
                   HorizontalAlignment="Center"
                   Margin="10"
                   Grid.Row="2">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding FilteredTours.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
