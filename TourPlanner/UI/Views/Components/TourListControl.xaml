<UserControl x:Class="TourPlanner.UI.Views.Components.TourListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="{DynamicResource MahApps.Brushes.Background}">
        <StackPanel Margin="20">

            <!-- Überschrift + Buttons -->
            <DockPanel Margin="0,0,0,10">
                <TextBlock Text="Tours"
                           FontSize="16"
                           FontWeight="Bold"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right">

                    <Button Content="Add"
                            Command="{Binding OpenAddTourWindowCommand}"
                            Background="MediumSeaGreen"
                            Foreground="White"
                            Padding="5"
                            Margin="0,0,5,0"
                            FontWeight="Bold"/>

                    <Button Content="Delete"
                            Command="{Binding DeleteTourCommand}"
                            Background="Crimson"
                            Foreground="White"
                            Padding="5"
                            Margin="0,0,5,0"
                            FontWeight="Bold"/>

                    <Button Content="Edit"
                            Command="{Binding OpenEditTourWindowCommand}"
                            Background="DarkOrange"
                            Foreground="White"
                            Padding="5"
                            FontWeight="Bold"/>
                </StackPanel>
            </DockPanel>

            <!-- Tour-Liste -->
            <ListBox ItemsSource="{Binding FilteredTours}"
                     SelectedItem="{Binding SelectedTour, Mode=TwoWay}"
                     MinHeight="100"
                     Background="{DynamicResource MahApps.Brushes.Control.Background}"
                     BorderBrush="{x:Null}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource MahApps.Brushes.Control.Background}"
                                Padding="6"
                                Margin="2"
                                CornerRadius="4">
                            <TextBlock Text="{Binding Name}" FontSize="14"/>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Kein Inhalt Hinweis -->
            <TextBlock Text="No tours available"
                       FontStyle="Italic"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       Margin="10,5,10,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilteredTours.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

        </StackPanel>
    </Grid>
</UserControl>
