<UserControl x:Class="TourPlanner.UI.Views.Components.TourDetailsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Button-Leiste -->
            <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,10">
                <Button Content="General" Style="{StaticResource SectionButtonStyle}" />
                <Button Content="Route" Style="{StaticResource SectionButtonStyle}" />
                <Button Content="Misc" Style="{StaticResource SectionButtonStyle}" />
            </UniformGrid>

            <!-- Trennlinie -->
            <Border Grid.Row="1" Background="#E0E0E0" Height="4" Margin="0,0,0,10"/>

            <!-- Tour-Details -->
            <StackPanel Grid.Row="2" DataContext="{Binding SelectedTour}" Margin="0,0,0,10">
                <Image Name="ImgTour" Height="180" Margin="0,0,0,10" Stretch="UniformToFill"/>

                <Grid Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Header -->
                    <TextBlock Text="Date" FontWeight="Bold" Grid.Row="0" Grid.Column="0" TextAlignment="Center"/>
                    <TextBlock Text="Description" FontWeight="Bold" Grid.Row="0" Grid.Column="1" TextAlignment="Center"/>
                    <TextBlock Text="From" FontWeight="Bold" Grid.Row="0" Grid.Column="2" TextAlignment="Center"/>
                    <TextBlock Text="To" FontWeight="Bold" Grid.Row="0" Grid.Column="3" TextAlignment="Center"/>
                    <TextBlock Text="Transport Type" FontWeight="Bold" Grid.Row="0" Grid.Column="4" TextAlignment="Center"/>

                    <!-- Werte -->
                    <TextBlock Text="{Binding Date}" Grid.Row="1" Grid.Column="0" TextAlignment="Center"/>
                    <TextBlock Text="{Binding Description}" Grid.Row="1" Grid.Column="1" TextAlignment="Center"/>
                    <TextBlock Text="{Binding From}" Grid.Row="1" Grid.Column="2" TextAlignment="Center"/>
                    <TextBlock Text="{Binding To}" Grid.Row="1" Grid.Column="3" TextAlignment="Center"/>
                    <TextBlock Text="{Binding TransportType}" Grid.Row="1" Grid.Column="4" TextAlignment="Center"/>
                </Grid>
            </StackPanel>

            <!-- Tour Logs -->
            <TextBlock Grid.Row="3" Text="Tour Logs" FontWeight="Bold" FontSize="16" Margin="0,10"/>
            <ListBox Grid.Row="3"
         ItemsSource="{Binding SelectedTour.TourLogs}"
         SelectedItem="{Binding SelectedTourLog, Mode=TwoWay}"
         Margin="0,30,0,10"
         MinHeight="100"
         BorderBrush="#DDD"
         BorderThickness="1"
         Background="White">

                <!-- Verhindert Verblassen bei Auswahl -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="Margin" Value="4"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Top"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                                        <ContentPresenter Margin="{TemplateBinding Margin}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#E0F7FA"/>
                                            <!-- Hover -->
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#B3E5FC"/>
                                            <!-- Auswahl -->
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <!-- Inhalt eines Log-Eintrags -->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Date}" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Comment}" FontStyle="Italic" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding Difficulty, StringFormat='Difficulty: {0}'}"/>
                            <TextBlock Text="{Binding TotalDistance, StringFormat='Distance: {0} km'}"/>
                            <TextBlock Text="{Binding TotalTime, StringFormat='Time: {0} h'}"/>
                            <TextBlock Text="{Binding Rating, StringFormat='Rating: {0}/5'}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Add Log" 
                        Command="{Binding OpenAddTourLogWindowCommand}" 
                        Style="{StaticResource ActionButtonGreenStyle}" Margin="5"/>
                <Button Content="Edit Log"
                        Command="{Binding OpenEditTourLogWindowCommand}"
                        IsEnabled="{Binding SelectedTourLog}"
                        Style="{StaticResource ActionButtonOrangeStyle}" Margin="5"/>
                <Button Content="Delete Log"
                        Command="{Binding DeleteTourLogCommand}"
                        IsEnabled="{Binding SelectedTourLog}"
                        Style="{StaticResource ActionButtonRedStyle}" Margin="5"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
