<Window x:Class="TourPlanner.UI.Views.AddTourWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Tour" Height="420" Width="450"
        Background="#FAFAFA" WindowStartupLocation="CenterScreen">

    <Border Background="White" CornerRadius="10" Padding="20" Margin="10" BorderBrush="#DDDDDD" BorderThickness="1" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titel -->
            <TextBlock Text="Add New Tour"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#333333"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- Formular -->
            <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="10,0" >
                <Label Content="Name:"/>
                <TextBox Text="{Binding NewTourName}" Margin="0,0,0,10" Padding="6"/>

                <Label Content="Description:"/>
                <TextBox Text="{Binding NewTourDesc}" Margin="0,0,0,10" Padding="6"/>

                <Label Content="From:"/>
                <TextBox Text="{Binding NewTourFrom}" Margin="0,0,0,10" Padding="6"/>

                <Label Content="To:"/>
                <TextBox Text="{Binding NewTourTo}" Margin="0,0,0,10" Padding="6"/>

                <Label Content="Transport Type:"/>
                <ComboBox ItemsSource="{Binding TransportTypes}"
                          SelectedItem="{Binding NewTourTransportType}"
                          Margin="0,0,0,10"
                          Padding="6"/>

                <Label Content="Image:"/>
                <Image Source="{Binding ImagePath}" Height="100" Margin="0,5"/>
                <Button Content="Choose Image"
                    Command="{Binding SelectImageCommand}"
                    Margin="0,0,0,10"
                    Padding="6"/>

            </StackPanel>

            <!-- Button -->
            <Button Content="Add Tour"
                    Grid.Row="2"
                    Command="{Binding ConfirmAddTourCommand}"
                    Background="#1976D2"
                    Foreground="White"
                    FontWeight="Bold"
                    Padding="10"
                    Margin="0,20,0,0"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"/>
        </Grid>
    </Border>
</Window>
