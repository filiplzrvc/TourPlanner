<Window x:Class="TourPlanner.UI.Views.AddTourWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Tour" Height="300" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Name:" Grid.Row="0" Grid.Column="0" Margin="5"/>
        <TextBox Text="{Binding NewTourName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Description:" Grid.Row="1" Grid.Column="0" Margin="5"/>
        <TextBox Text="{Binding NewTourDesc, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Margin="5"/>

        <TextBlock Text="From:" Grid.Row="2" Grid.Column="0" Margin="5"/>
        <TextBox Text="{Binding NewTourFrom, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" Margin="5"/>

        <TextBlock Text="To:" Grid.Row="3" Grid.Column="0" Margin="5"/>
        <TextBox Text="{Binding NewTourTo, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Transport Type:" Grid.Row="4" Grid.Column="0" Margin="5"/>
        <ComboBox ItemsSource="{Binding TransportTypes}" SelectedItem="{Binding NewTourTransportType}" Grid.Row="4" Grid.Column="1" Margin="5"/>

        <Button Content="Add Tour" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="5" Padding="5"
                Command="{Binding ConfirmAddTourCommand}"/>
    </Grid>
</Window>
