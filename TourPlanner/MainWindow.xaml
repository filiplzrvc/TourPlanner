<Window x:Class="TourPlanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TourPlanner"
        mc:Ignorable="d"
        Title="Tours" Height="350" Width="525">

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" VerticalAlignment="Top" Margin="5,0,5,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="File" Grid.Column="0"></Button>
                <Button Content="Edit" Grid.Column="1"></Button>
                <Button Content="Options" Grid.Column="2"></Button>
                <Button Content="Help" Grid.Column="3"></Button>
            </Grid>
        </DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <Grid VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="Search..." Grid.Column="0" Margin="5"></TextBox>
                <Button Content="search" Grid.Column="1" Margin="5" ></Button>
            </Grid>
        </DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Margin="5">
                    <Grid>
                        <TextBlock Background="Aqua" Text="Tours" Padding="3" HorizontalAlignment="Left"></TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Background="Aqua" Content="+" Padding="3"></Button>
                            <Button Background="Aqua" Content="-" Padding="3"></Button>
                            <Button Background="Aqua" Content="..." Padding="3"></Button>
                        </StackPanel>
                    </Grid>
                    <Border Background="Aqua" Height="5"></Border>

                    <ListBox ItemsSource="{Binding Tours}" Margin="10" SelectionChanged="ListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Margin="3"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>


                </StackPanel>
                <StackPanel  DataContext="{Binding SelectedTour}" Grid.Column="1" Margin="5">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="General" Margin="3,3,3,0"></Button>
                        <Button Content="Route" Margin="3,3,3,0"></Button>
                        <Button Content="Misc" Margin="3,3,3,0" ></Button>
                    </StackPanel>
                    <Border Background="Aqua" Height="5"></Border>
                    <Image Source= "{Binding Image}" Margin="3" Height="150" Width="300"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Date:" Grid.Row="0" Grid.Column="0" Margin="5"/>
                        <TextBlock Text="{Binding Date}" Grid.Row="0" Grid.Column="1" Margin="5"/>

                        <TextBlock Text="Name:" Grid.Row="1" Grid.Column="0" Margin="5"/>
                        <TextBlock Text="{Binding Name}" Grid.Row="1" Grid.Column="1" Margin="5"/>

                        <TextBlock Text="Description:" Grid.Row="2" Grid.Column="0" Margin="5"/>
                        <TextBlock Text="{Binding Description}" Grid.Row="2" Grid.Column="1" Margin="5"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
