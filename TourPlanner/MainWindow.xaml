<Window x:Class="TourPlanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TourPlanner"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" VerticalAlignment="Top" Margin="5,0,5,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="File" Grid.Column="0"></Button>
                <Button Content="Edit" Grid.Column="1"></Button>
                <Button Content="Options" Grid.Column="2"></Button>
                <Button Content="Help" Grid.Column="3"></Button>
            </Grid>
        </DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <Grid VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="Search..." Grid.Column="0" Margin="5"></TextBox>
                <Button Content="search" Grid.Column="1" Margin="5" ></Button>
            </Grid>
        </DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="5">
                    <Grid>
                        <TextBlock Background="Aqua" Text="Tours" Padding="3" HorizontalAlignment="Left"></TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Background="Aqua" Content="+" Padding="3"></Button>
                            <Button Background="Aqua" Content="-" Padding="3"></Button>
                            <Button Background="Aqua" Content="..." Padding="3"></Button>
                        </StackPanel>
                    </Grid>
                    <Border Background="Aqua" Height="5"></Border>
                    <TextBlock Text="Wienerwald" Margin="3"></TextBlock>
                    <TextBlock Text="DopplerhÃ¼tte" Margin="3"></TextBlock>
                    <TextBlock Text="Figlwarte" Margin="3"></TextBlock>
                    <TextBlock Text="Dorfrunde" Margin="3"></TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="5">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="General" Margin="3,3,3,0"></Button>
                        <Button Content="Route" Margin="3,3,3,0"></Button>
                        <Button Content="Misc" Margin="3,3,3,0" ></Button>
                    </StackPanel>
                    <Border Background="Aqua" Height="5"></Border>
                    <Image Source="https://www.datocms-assets.com/50871/1716498222-final-2024-ticketoffice-map-95-75x59-2156x1328.jpg" Margin="3" Height="150"/>
                    <DataGrid AutoGenerateColumns="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Width="*"/>
                            <DataGridTextColumn Header="Duration" Width="*"/>
                            <DataGridTextColumn Header="Distance" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
